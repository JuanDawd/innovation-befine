{
  "name": "@befine/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./pedido-totals": "./src/queries/pedido-totals.ts",
    "./pedido-status": "./src/queries/pedido-status.ts",
    "./day-income": "./src/queries/day-income.ts"
  },
  "scripts": {
    "db:generate": "dotenv -e ../../.env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env.local -- node --import tsx/esm src/migrate.ts",
    "db:studio": "dotenv -e ../../.env.local -- drizzle-kit studio",
    "db:check": "dotenv -e ../../.env.local -- drizzle-kit check",
    "db:seed": "dotenv -e ../../.env.local -- node --import tsx/esm src/seed.ts",
    "db:bench:analytics": "dotenv -e ../../.env.local -- node --import tsx/esm src/bench-analytics.ts",
    "db:import:clients": "dotenv -e ../../.env.local -- node --import tsx/esm src/import-clients.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:reset-test-data": "node --import tsx/esm src/reset-test-data.ts"
  },
  "dependencies": {
    "@better-auth/utils": "^0.5.1",
    "@neondatabase/serverless": "^1.2.0",
    "@types/ws": "^8.18.2",
    "drizzle-orm": "^0.45.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
