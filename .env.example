# ============================================================
# Innovation Befine — Environment Variables
# Copy to .env.local and fill in real values.
# ============================================================

# --- General ---
NODE_ENV=development
# Set to "1" to skip env validation (useful for CI build steps that don't need runtime vars)
SKIP_ENV_VALIDATION=

# --- Database (Neon Postgres) — T005 ---
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# Optional — direct (non-pooled) URL for realtime LISTEN/NOTIFY (M-60). When unset,
# a Neon "-pooler." DATABASE_URL is converted automatically; any other URL keeps
# realtime single-process (dev, CI).
DATABASE_URL_UNPOOLED=

# --- Auth (Better Auth) — T007 ---
# Minimum 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-minimum-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) — T054 ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Innovation Befine <noreply@yourdomain.com>

# --- DB transaction pool (L-49) ---
# Sockets per instance for transactions (1–100, default 5). Keep 5 on Vercel;
# raise for a single self-hosted process, within Neon's connection budget.
# DB_TX_POOL_MAX=5

# --- Auth origins (L-48) ---
# Extra origins allowed by Better Auth, comma-separated (custom domain, LAN host).
# BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL are always trusted.
# BETTER_AUTH_TRUSTED_ORIGINS=

# --- Rate limiting (Upstash Redis) — M-59 ---
# Required in production so limits hold across Vercel instances.
# Unset → per-process in-memory limiter (fine for local dev / tests).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Real-time (SSE) — T009 ---
# No environment variables needed — SSE uses native Next.js Route Handlers

# --- Error tracking (Sentry) — T085 (optional for dev) ---
# SENTRY_DSN=https://xxxxx@o12345.ingest.sentry.io/12345          # server-side
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@o12345.ingest.sentry.io/12345  # client-side (same value)
# SENTRY_AUTH_TOKEN=sntrys_xxxx   # for source map uploads in CI
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# --- Client-side public variables ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Tenant brand (white-label) ---
# NEXT_PUBLIC_BRAND_NAME=Befine
# NEXT_PUBLIC_BRAND_FULL_NAME=Innovation Befine
# NEXT_PUBLIC_BRAND_UNITS=DoWell,Swimwear

# --- Seed and E2E passwords (T011, M-71) ---
# Required by packages/db/src/seed.ts — there are no defaults. Use your own
# values (min. 8 chars); E2E logs in with the same values via E2E_*_PASSWORD.
# Never seed a shared or production database.
# SEED_ADMIN_PASSWORD=
# SEED_SECRETARY_PASSWORD=
# SEED_STYLIST_PASSWORD=
# SEED_CLOTHIER_PASSWORD=
# E2E_ADMIN_PASSWORD=
# E2E_SECRETARY_PASSWORD=
# E2E_STYLIST_PASSWORD=
# E2E_CLOTHIER_PASSWORD=
